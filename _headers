# Cache untuk hosting Netlify / Cloudflare Pages (diabaikan oleh hosting lain)
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=2592000
/*.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
